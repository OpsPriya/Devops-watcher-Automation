# Inventory database connection
DB_HOST=db.example.internal
DB_PORT=3306
DB_NAME=site_inventory
DB_USER=watcher_user
DB_PASSWORD=replace_with_secret_at_runtime

# Label applied to records discovered by this watcher instance
DB_ENVIRONMENT=development

# Comma-separated application roots and relative config paths
WATCH_ROOTS=/opt/apps/sites,/srv/apps/sites
WATCH_PATTERNS=init/config.php,config/database.php,app/config/database.php

# Runtime settings
POLL_INTERVAL=30
DB_POOL_SIZE=5
LOG_LEVEL=INFO
